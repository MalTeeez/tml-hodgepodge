Configs: {
	ClientConfig: {
		DisplayName: Client patches

		TileEdgeHighlightGuard: {
			Label: CalamityHunt tile edge highlight
			Tooltip: Stops the overlay being rebuilt on frames where it is not drawn.
		}

		ConstellationStarBuffer: {
			Label: NoxusBoss constellation star buffer
			Tooltip: Sizes the star buffer to the stars in use instead of to its capacity.
		}

		ForegroundDoubleUpdate: {
			Label: Calamity foreground double step
			Tooltip:
				'''
				Steps foreground effects once per tick instead of once per tick and once per frame.
				Halves the density and fall speed of the rain against how it looks today.
				'''
		}

		PlayerPostProcessingRedraw: {
			Label: NoxusBoss player post processing
			Tooltip: Redraws a player into a shader target only when a shader asked for one.
		}

		FullBrightDispatch: {
			Label: SOTS fullbright dispatch
			Tooltip:
				'''
				Inlines the fullbright test into the lighting engine and drops the detour around it.
				'''
		}

		AprilFoolsDateCheck: {
			Label: April Fools Date Check
			Tooltip: Skips the April Fools date work outside single player, where it cannot apply.
		}

		LostColosseumSceneCheck: {
			Label: UnCalamityModMusic lost colosseum check
			Tooltip:
				'''
				Tests the biome flag before building a throwaway NPC to read a kill count from.
				Was 98% of every NPC.SetDefaults call in the game.
				'''
		}

		ExoMechSkyLookup: {
			Label: InfernumModeMusic exo mech sky lookup
			Tooltip: Resolves the Calamity sky property once at load instead of once per tick.
		}

		LootBeamBatchMode: {
			Label: LootBeams batch sort mode
			Tooltip:
				'''
				Draws loot beams in a deferred batch instead of flushing to the GPU per sprite,
				and hands the item pass back in the sort mode vanilla opened it with.
				'''
		}

		WallClockDateCache: {
			Label: Wall clock date reads
			Tooltip:
				'''
				Answers the per tick DateTime.Now reads in Thorium, CalValEX and Ragnarok from a
				value refreshed once a second. All three together, since patching one alone moves
				the cost to whichever caller then goes first.
				'''
		}

		SubworldActiveScan: {
			Label: Calamity subworld scan
			Tooltip:
				'''
				Asks SubworldLibrary once whether a subworld is active, instead of once per loaded
				mod through a string keyed mod call.
				'''
		}

		NearbyEffectsBlockDispatch: {
			Label: Nearby effects block dispatch
			Tooltip:
				'''
				Moves the pylon scanning test that MagicStorage and SerousCommonLib each detour
				TileLoader.NearbyEffects for into the method itself, dropping both detours.
				'''
		}

		TileLightProjectileBonus: {
			Label: StarsAbove tile light backgrounds
			Tooltip:
				'''
				Replaces three per tile lighting detours with one, reading a value computed once a
				tick.
				'''
		}

		PolarityPulseBatchGuard: {
			Label: Calamity polarity pulse batch
			Tooltip:
				'''
				Skips the two sprite batch restarts Calamity performs for every NPC drawn when
				that NPC has no pulse particles to draw, which is nearly always.
				'''
		}

		WorkshopTileCenterReuse: {
			Label: UnCalamityModMusic tile centres
			Tooltip:
				'''
				Empties the recorded tile centre lists in place instead of discarding them each
				scan, so they stop being regrown from nothing every time.
				'''
		}

		DrawTimeLogging: {
			Label: Vanilla draw time logging
			Tooltip:
				'''
				Stops TimeLogger reading a stopwatch for every draw phase when nothing is recording a
				frame time log. Its cold entry points already test the same flag.
				'''
		}

		TilePreDrawContentIds: {
			Label: SOTS tile content ids
			Tooltip:
				'''
				Replaces the ModContent tile and wall id lookups in SOTS's per tile PreDraw with the
				ids themselves, resolved once at load.
				'''
		}

		BossIntroScreenGate: {
			Label: Infernum boss intro screens
			Tooltip:
				'''
				Skips the boss introduction screen update and draw while Infernum's own
				BossIntroductionAnimationsAreAllowed setting is off.
				'''
		}

		MusicEventTrackLookup: {
			Label: UnCalamityModMusic event track
			Tooltip:
				'''
				Resolves the Calamity music event property once at load instead of searching Calamity's
				assembly for it by name every tick.
				'''
		}

		ShaderDrawerSortDiscarded: {
			Label: NoxusBoss shader drawer sort
			Tooltip:
				'''
				Drops a sort whose result NoxusBoss never assigns, run once per frame over every shader
				drawing projectile and NPC.
				'''
		}

		CurseDustPixelCache: {
			Label: SOTS curse dust pixels
			Tooltip:
				'''
				Reads the Pharaoh's Curse dust textures back off the GPU once instead of five times a
				tick. Only costs anything while that boss is alive.
				'''
		}

		DebuffProjectileScan: {
			Label: SOTS debuff projectile scan
			Tooltip: Skips dead projectile slots in the per NPC per tick scan, which none of its tests could match anyway.
		}

		CurseIconDrawGate: {
			Label: SOTS curse icon draw
			Tooltip:
				'''
				Skips the nine curse icon texture lookups on an NPC carrying no SOTS curse, which is
				every NPC the icons were never going to be drawn on.
				'''
		}

		LootBeamTextureCache: {
			Label: LootBeams texture lookup
			Tooltip:
				'''
				Answers the beam and glow texture lookups from a table instead of asking the asset
				repository for them by name on every item on every frame.
				'''
		}

		WhipBuffImmunityScan: {
			Label: Whip addon buff immunity
			Tooltip:
				'''
				Clears immunity for the whip addon's own buffs from a list built once, instead of
				walking every buff type in the game once per NPC per tick.
				'''
		}

		BlueMoonBuffLookup: {
			Label: InfernalEclipseAPI blue moon buffs
			Tooltip:
				'''
				Resolves the BlueMoon buff handles once at load instead of rebuilding them by name
				once per player per tick.
				'''
		}

		AstrageldonPresenceScan: {
			Label: CalamityHunt Astrageldon check
			Tooltip:
				'''
				Tests the NPC type before scanning the world for Goozma, and drops a second scan
				whose result CalamityHunt never reads.
				'''
		}

		LingeringFieldParticleBroadcast: {
			Label: StarsAbove lingering field particles
			Tooltip:
				'''
				Spawns the particles from three StarsAbove damage fields locally instead of sending
				each one through the server and back. Every client already raises its own, so this
				removes the duplicates and the traffic rather than the effect.
				'''
		}

		LingeringFieldParticleVisibility: {
			Label: StarsAbove lingering field particles off screen
			Tooltip:
				'''
				Skips those particles for fields outside the view, where they are never drawn but
				still hold a pool slot. Needs the setting above on, or it would decide what other
				players see as well.
				'''
		}

		ParticlePoolScanCursor: {
			Label: Particle pool search
			Tooltip:
				'''
				Resumes vanilla's search for a free particle where the last one succeeded instead of
				restarting at the front of the pool. Particles are reused and drawn in a different
				order within a pool. Unmeasured, and it rewrites a type every mod's particles use.
				'''
		}

		SceneEffectWeightCapacity: {
			Label: Scene effect weight list
			Tooltip:
				'''
				Gives tModLoader's per tick scene effect list a capacity so it stops regrowing from
				empty.
				'''
		}

		InfernalItemBalanceCache: {
			Label: InfernalEclipseAPI item balance lookups
			Tooltip:
				'''
				Answers the item balance helper from a table built once instead of rebuilding four
				dictionary lookups for every one of the hundreds of items it tests per item synced.
				'''
		}

		ModTypeNameCache: {
			Label: Daybreak mod type names
			Tooltip:
				'''
				Remembers the name Daybreak derives for each content type instead of asking
				reflection for it again every time a mod reads one.
				'''
		}

		InfernalBossBuffScan: {
			Label: InfernalEclipseAPI boss buff scan
			Tooltip:
				'''
				Asks whether an NPC is a boss before walking all 255 player slots for it, rather
				than after. Only a boss could ever have used the result.
				'''
		}

		TimeFrozenIdLookup: {
			Label: InfernalEclipseAPI time freeze checks
			Tooltip: Folds the NPC ids this per NPC per tick check rebuilds by name into constants.
		}

		ResetEffectsContentIds: {
			Label: Calamity NPC reset effects ids
			Tooltip:
				'''
				Folds the content id lookups Calamity resolves for every NPC every tick into
				constants.
				'''
		}

		VoidAnomalyRangeGuard: {
			Label: SOTS Void Anomaly collision range
			Tooltip:
				'''
				Skips the Void Anomaly's per entity work for anything too far away to be pulled or
				pushed, before the distance maths rather than after it.
				'''
		}

		LumenylCrystalScan: {
			Label: Infernum Lumenyl crystal sweep
			Tooltip:
				'''
				Narrows Infernum's 32,000 tile per frame search for Abyss crystals to the tiles on
				screen, which are the only ones whose result is ever visible.
				'''
		}

		CurseFoamDrawGate: {
			Label: SOTS curse foam draw
			Tooltip:
				'''
				Skips the foam texture lookup when there is no foam to draw, answers it from a table
				when there is, and folds the projectile ids the per player scan resolves per slot.
				'''
		}

		NebulaFoamDrawGate: {
			Label: Catalyst nebula foam draw
			Tooltip: The same fix as the SOTS one above, for Catalyst's copy of the same helper.
		}

		PlasmaGenBossScan: {
			Label: InfernalEclipseAPI plasma generator blocker
			Tooltip:
				'''
				Asks once per tick whether a blocking boss is alive, instead of seventeen world
				scans per accessory per player per tick.
				'''
		}

		BossPromptPresenceScan: {
			Label: StarsAbove boss prompts
			Tooltip:
				'''
				Runs the ninety-odd boss prompt checks only on ticks where one of those bosses is
				alive, found by one scan per tick instead of one per boss per player.
				'''
		}

		NuclearTorrentInvisibleDraw: {
			Label: Calamity nuclear torrent invisible draw
			Tooltip:
				'''
				Skips drawing and simulating the torrent and its rain while it is faded out and not
				showing, where every sprite is transparent, and answers the raindrop texture lookup
				from a table. The rain fills in over about a second on the first torrent of a world.
				'''
		}

		SeaPrismPresenceScan: {
			Label: Calamity sea prism shader passes
			Tooltip:
				'''
				Skips the sea prism tile and wall shader passes, and the batch restarts they need,
				on frames where no sea prism is on screen.
				'''
		}

		EmptyPixelationTargetDraw: {
			Label: Calamity and Luminance pixelation targets
			Tooltip:
				'''
				Skips the thirteen per frame fullscreen draws of pixelation targets that nothing
				drew into this frame. Each was a batch restart to draw a transparent texture.
				'''
		}

		MusicFlagsLocalPlayer: {
			Label: UnCalamityModMusic flags per player
			Tooltip:
				'''
				Derives the music flags once per tick from the local player instead of once per
				player in the world, all from the local player. No change in single player.
				'''
		}

		CritterBestiaryRegistration: {
			Label: CalValEX critter bestiary
			Tooltip:
				'''
				Registers a nearby critter from its content sample instead of a throwaway NPC, and
				only while its bestiary entry is not yet fully unlocked.
				'''
		}

		XykWingCountScan: {
			Label: Calamity Xyk wing count
			Tooltip:
				'''
				Counts a player's wings once per wing update and once per owner per draw instead of
				once per question, and answers the wing textures from a table.
				'''
		}

		PlayerDrawTextureCache: {
			Label: Calamity player draw textures
			Tooltip:
				'''
				Answers the tail and backpack texture lookups from a table instead of asking the
				asset repository by name once per player per frame.
				'''
		}

		AuricSoulSceneItemIds: {
			Label: CalamityHunt auric soul scenes
			Tooltip: Folds the item id each soul scene resolves per item slot per tick into a constant.
		}

		StellarNovaTextGate: {
			Label: StarsAbove Stellar Nova panel text
			Tooltip:
				'''
				Builds the Stellar Nova panel's seven strings only while the panel is open or fading
				out. The nova numbers and set bonuses beside them still run every tick.
				'''
		}

		CosmosMetaballIdleDraw: {
			Label: CalamityHunt black hole shade
			Tooltip:
				'''
				Skips the per frame render target and fullscreen shader pass for Goozma's black hole
				while no black hole projectile or particle exists to draw into it.
				'''
		}

		HeldItemSnapshotClone: {
			Label: Vanilla held item clone
			Tooltip:
				'''
				Keeps the held item clone that draw code reads while the item's type, stack and
				prefix are unchanged, which is vanilla's own test during item use, instead of
				cloning it and every mod's item data once per player per tick.
				'''
		}

		MouseItemSlotClone: {
			Label: Vanilla mouse item slot clone
			Tooltip:
				'''
				Keeps the clone in temporary held-item slot 58 while the mouse item's type, stack
				and prefix are unchanged, instead of cloning it and every mod's item data once per
				tick while the inventory is open.
				'''
		}

		ForgeRecipeConditionDispatch: {
			Label: NoxusBoss forge recipe conditions
			Tooltip:
				'''
				Inlines the Starlit Forge adjacency test into the two recipe checks and drops the
				detours around it. Unmeasured, and it takes over a NoxusBoss feature rather than
				removing dead work.
				'''
		}
	}
}
